  "fixed_sql": [
    {
      "name": "games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"games\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"template\" TEXT NOT NULL, \"play_mode\" TEXT NOT NULL, \"seat_count\" INTEGER NOT NULL, \"rules_json\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"first_dealer_seat\" INTEGER NOT NULL DEFAULT 0, \"dealer_offset\" INTEGER NOT NULL DEFAULT 0, \"dealer_indicator\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dealer_indicator\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "seat_occupants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"seat_occupants\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" INTEGER NOT NULL REFERENCES games (id) ON DELETE CASCADE, \"seat\" INTEGER NOT NULL, \"player_name\" TEXT NOT NULL, \"from_sequence\" INTEGER NOT NULL, UNIQUE (\"game_id\", \"seat\", \"from_sequence\"));"
        }
      ]
    },
    {
      "name": "rounds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rounds\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" INTEGER NOT NULL REFERENCES games (id) ON DELETE CASCADE, \"sequence\" INTEGER NOT NULL, \"input_json\" TEXT NOT NULL, \"points_json\" TEXT NOT NULL, \"multiplier\" INTEGER NOT NULL DEFAULT 1, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"game_id\", \"sequence\"));"
        }
      ]
    },
    {
      "name": "undo_actions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"undo_actions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" INTEGER NOT NULL REFERENCES games (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "player_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"player_groups\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"members_json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"keep_screen_on\" INTEGER NOT NULL DEFAULT 1 CHECK (\"keep_screen_on\" IN (0, 1)), \"haptics\" INTEGER NOT NULL DEFAULT 1 CHECK (\"haptics\" IN (0, 1)), \"dealer_indicator_default\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dealer_indicator_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "undo_actions_game",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX undo_actions_game ON undo_actions (game_id)"
        }
      ]
    }
  ]
